generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String              @id @default(uuid())
  name        String
  /// Часовой пояс организации в виде IANA: сроки объектов считаются в нём,
  /// а не в поясе браузера того, кто открыл страницу.
  timeZone    String              @default("Europe/Moscow")
  /// Валюта учёта. Одна на организацию: смета, начисления и акты в разных
  /// валютах не складываются.
  currency    String              @default("RUB")
  phone       String?
  email       String?
  /// Реквизиты исполнителя для шапки акта: ИНН, счёт, банк — одним полем.
  ///
  /// Свободным текстом, а не набором граф — решение заказчика от 13.09.2026
  /// и то же устройство, что у реквизитов заказчика (`Client.requisites`).
  /// Набор граф пришлось бы придумывать за компанию, а печатается всё равно
  /// то, что вписал руководитель.
  requisites  String?
  /// Ключ логотипа в объектном хранилище. Сам файл в базе не лежит.
  logoKey     String?
  createdAt   DateTime            @default(now())
  auditLog    AuditLog[]
  clients     Client[]
  templates   DocumentTemplate[]
  blueprints  EstimateBlueprint[]
  feedbacks   Feedback[]
  leadTasks   LeadTask[]
  leads       Lead[]
  projects    Project[]
  repairTypes RepairType[]
  units       Unit[]
  users       User[]
  workers     Worker[]

  @@map("organizations")
}

/// Шаблон документа: договор, дополнительное соглашение, прочая бумага.
///
/// Тело хранится пунктами, а не одним полотном текста: пункт нумеруется,
/// переставляется и правится отдельно, и документ на двадцать пунктов,
/// лежащий одной строкой, правится только целиком.
///
/// Оформления в шаблоне нет. Бланк задаёт система — тот же, что у акта; иначе
/// вид документа уходит из-под дизайн-системы к тому, кто последним правил
/// шаблон.
model DocumentTemplate {
  id        String           @id @default(uuid())
  orgId     String
  name      String
  kind      TemplateKind     @default(CONTRACT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  clauses   DocumentClause[]
  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@map("document_templates")
}

/// Пункт шаблона. Заголовок и текст; метки переменных стоят прямо в тексте.
model DocumentClause {
  id         String           @id @default(uuid())
  templateId String
  order      Int
  title      String
  body       String
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, order])
  @@map("document_clauses")
}

/// Типовая смета организации: заготовка под повторяющийся вид ремонта.
///
/// Слово «шаблон» в продукте занято дважды — эталонной книгой выгрузки и
/// шаблонами документов организации, — и третьего значения ему не даётся:
/// одно слово на одну вещь. Поэтому «типовая смета».
///
/// Заводится из готовой сметы объекта и несёт всё, кроме привязок к нему:
/// разделы, наименования, единицы, цены, ставки и количества. Помещения не
/// уносятся — помещение принадлежит объекту, а не типу ремонта.
model EstimateBlueprint {
  id          String             @id @default(uuid())
  orgId       String
  name        String
  /// Откуда взята: код объекта на момент заведения. Строкой, а не связью —
  /// объект могут удалить, а происхождение заготовки от этого не меняется.
  sourceCode  String?
  createdById String?
  createdAt   DateTime           @default(now())
  items       BlueprintItem[]
  sections    BlueprintSection[]
  createdBy   User?              @relation(fields: [createdById], references: [id])
  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@map("estimate_blueprints")
}

/// Раздел типовой сметы. Дерево той же глубины, что и у сметы объекта.
model BlueprintSection {
  id          String             @id @default(uuid())
  blueprintId String
  parentId    String?
  name        String
  order       Int
  items       BlueprintItem[]
  parent      BlueprintSection?  @relation("BlueprintTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    BlueprintSection[] @relation("BlueprintTree")
  blueprint   EstimateBlueprint  @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId, order])
  @@map("blueprint_sections")
}

/// Позиция типовой сметы. Количество хранится: решение заказчика от
/// 14.09.2026 — заготовка полная, правится под объект после применения.
model BlueprintItem {
  id          String            @id @default(uuid())
  blueprintId String
  sectionId   String
  unitId      String
  name        String
  order       Int
  /// Количество в тысячных долях единицы измерения.
  qty         BigInt
  /// Цена единицы и ставка оплаты труда, копейки.
  unitPrice   BigInt
  unitWage    BigInt            @default(0)
  unit        Unit              @relation(fields: [unitId], references: [id])
  section     BlueprintSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  blueprint   EstimateBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId, order])
  @@index([sectionId, order])
  @@map("blueprint_items")
}

model User {
  id                String              @id @default(uuid())
  orgId             String
  role              Role
  name              String
  email             String?
  phone             String?
  /// Запись справочника, от лица которой входит заказчик.
  ///
  /// Обязательна для роли `CLIENT` и пуста у прочих: видимость объектов
  /// заказчика строится по ней (`project-scope.ts`). Заказчик без связи с
  /// записью справочника видел бы либо всё, либо ничего — оба исхода неверны.
  clientId          String?
  createdAt         DateTime            @default(now())
  /// Дата снятия доступа; пусто — доступ действует.
  ///
  /// Снятие не удаляет строку: удаление через `onDelete: SetNull` стирало
  /// авторство в журнале, приёмке и чеках (полный аудит 30.09.2026, П-51;
  /// решение заказчика от 01.10.2026). Снятый не входит, ссылок и кодов не
  /// получает и в списках выбора не стоит; повторная выдача входа по той же
  /// почте или телефону возвращает эту же запись.
  revokedAt         DateTime?
  /// Последний заход заказчика (этап Э8, ДР-1; решение допроса Э8-2): заход —
  /// открытие приложения. Служит одному отбору — «Новое с прошлого входа» в
  /// очереди заказчика — и никому не показывается: учёт рабочего времени в
  /// объём не входит. Пусто — заказчик ещё не заходил: ему показывается
  /// экран первого входа.
  lastSeenAt        DateTime?
  acceptanceBatches AcceptanceBatch[]
  acceptancePhotos  AcceptancePhoto[]
  acceptances       Acceptance[]
  auditEntries      AuditLog[]
  authTokens        AuthToken[]
  blueprints        EstimateBlueprint[]
  expensesConfirmed MaterialExpense[]   @relation("ExpenseConfirmer")
  expensesCreated   MaterialExpense[]   @relation("ExpenseAuthor")
  measurePlans      MeasurePlan[]
  projectFiles      ProjectFile[]
  projectsAsForeman Project[]           @relation("ProjectForeman")
  sessions          Session[]
  tranchePayments   TranchePayment[]
  tranches          Tranche[]
  client            Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization      Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([orgId, role])
  @@map("users")
}

model Client {
  id               String       @id @default(uuid())
  orgId            String
  /// Короткий код клиента, как в обиходе заказчика: [300] И. Иванов.
  code             String
  name             String
  isCompany        Boolean      @default(false)
  requisites       String?
  /// Порог просрочки оплаты в днях по договору с этим заказчиком.
  ///
  /// Заведено ответом заказчика на вопрос 5 квиза от 19.09.2026: единого
  /// порога по компании больше нет. Пусто — действует умолчание
  /// `PAYMENT_GRACE_DAYS` (семь дней); без умолчания заказчик с незаполненным
  /// полем выпал бы из учёта просрочки вовсе, а не стал бы «никогда не
  /// просроченным» осознанно.
  paymentGraceDays Int?
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads            Lead[]
  projects         Project[]
  users            User[]

  @@unique([orgId, code])
  @@map("clients")
}

model Project {
  id                String            @id @default(uuid())
  orgId             String
  /// Сквозной короткий код объекта: почта, документы, разговор, акт — R-99.
  code              String
  address           String
  clientId          String
  foremanId         String?
  status            ProjectStatus     @default(NEW)
  /// Чего ждём при статусе «Ждёт ответа»: что и от кого, до 140 знаков
  /// (этап Э8, ДР-4). Обязательно при этом статусе и очищается со сменой
  /// статуса — прежний текст остаётся в журнале. Видно всем ролям объекта,
  /// включая заказчика: чаще всего это вопрос к нему.
  waitingFor        String?
  /// Дата начала работ на объекте. Отличается от даты заведения объекта в
  /// системе: объект может быть заведён задолго до выхода бригады.
  startedAt         DateTime?
  deadline          DateTime?
  keysCount         Int               @default(0)
  /// Надбавка «сопровождение объекта» в сотых долях процента: 1200 = 12,00 %.
  supervisionShare  Int               @default(1200)
  createdAt         DateTime          @default(now())
  acceptanceBatches AcceptanceBatch[]
  estimates         Estimate[]
  lead              Lead?
  expenses          MaterialExpense[]
  measurePlans      MeasurePlan[]
  measureRooms      MeasureRoom[]
  files             ProjectFile[]
  foreman           User?             @relation("ProjectForeman", fields: [foremanId], references: [id])
  client            Client            @relation(fields: [clientId], references: [id])
  organization      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tranches          Tranche[]
  workStages        WorkStage[]

  @@unique([orgId, code])
  @@index([orgId, status])
  @@map("projects")
}

/// Нормализованный справочник единиц измерения. Редактируется руководителем:
/// в сметах встречаются написания, которых нет в каноническом наборе.
model Unit {
  id             String          @id @default(uuid())
  orgId          String
  /// Каноническая форма: м², м.п., шт, точка, ед, рейс, ч/ч, этаж, %.
  code           String
  blueprintItems BlueprintItem[]
  estimateItems  EstimateItem[]
  otherExpenses  OtherExpense[]
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, code])
  @@map("units")
}

/// Смета объекта.
///
/// Редакция растёт **только при импорте**. Правка позиции — количества,
/// наименования, единицы, цены и ставки — идёт на месте с записью прежнего
/// значения в AuditLog (Р11 в редакции от 09.09.2026, БП-10).
///
/// Прежняя формулировка «цены и ставки порождают новую версию» снята: приёмка
/// ссылается на позицию конкретной редакции, связи между редакциями позиции
/// нет, и правка одной цены унесла бы всё принятое из вида приёмки, оставив
/// его в выработке транша. Начисленное защищено снимком ставки (БП-03).
model Estimate {
  id                 String            @id @default(uuid())
  projectId          String
  version            Int               @default(1)
  /// Надбавка «сопровождение объекта» в сотых долях процента.
  supervisionShare   Int               @default(1200)
  /// Заявленный в исходном файле итог по работам, копейки. Хранится, чтобы
  /// расхождение оставалось проверяемым и после импорта (БП-09).
  declaredWorksTotal BigInt?
  /// Объявлено, но ни одной строкой кода не читается и не пишется. Долг
  /// назван прямо, чтобы разбор охраны не принял его за работающую защиту:
  /// снятие поля требует миграции, применение — решения о том, кто и когда
  /// запирает смету.
  isLocked           Boolean           @default(false)
  createdAt          DateTime          @default(now())
  imports            EstimateImport[]
  items              EstimateItem[]
  sections           EstimateSection[]
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  otherExpenses      OtherExpense[]

  @@unique([projectId, version])
  @@map("estimates")
}

/// Раздел сметы. Вложенность — через parentId; в файле заказчика два уровня.
model EstimateSection {
  id         String            @id @default(uuid())
  estimateId String
  parentId   String?
  name       String
  order      Int
  /// Строка исходного файла: связь с источником для разбора расхождений.
  sourceRow  Int?
  batches    AcceptanceBatch[]
  items      EstimateItem[]
  parent     EstimateSection?  @relation("SectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   EstimateSection[] @relation("SectionTree")
  estimate   Estimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  expenses   MaterialExpense[]
  stage      WorkStage?

  @@index([estimateId, order])
  @@map("estimate_sections")
}

/// Позиция сметы. Приёмке подлежат именно эти строки.
model EstimateItem {
  id          String          @id @default(uuid())
  estimateId  String
  sectionId   String
  unitId      String
  name        String
  order       Int
  /// Количество в тысячных долях единицы измерения.
  qty         BigInt
  /// Цена единицы и ставка оплаты труда, копейки.
  unitPrice   BigInt
  unitWage    BigInt          @default(0)
  sourceRow   Int?
  /// Помещение обмера, работы которого ведёт позиция.
  ///
  /// Необязательно, и это не заготовка под обязательность: смета приходит
  /// из файла, а импортёр помещений не знает вовсе — обмер делают отдельно
  /// и нередко позже. Отдельного помещения «Без помещения» для таких
  /// позиций не заводится: строка обмера без замера попала бы в итоги
  /// площадей и развела бы их с обмерным планом.
  roomId      String?
  /// Позиция снята со сметы (план, пункт 7.3). Ставится только позиции, вся
  /// приёмка которой сторнирована: записи приёмки держат её внешним ключом,
  /// а история не переписывается. Снятая позиция не входит ни в вид сметы,
  /// ни в итоги, ни в приёмку; её записи приёмки и сторно остаются.
  /// Позицию без приёмки удаляют строкой — отметка ей не нужна.
  removedAt   DateTime?
  acceptances Acceptance[]
  room        MeasureRoom?    @relation(fields: [roomId], references: [id])
  unit        Unit            @relation(fields: [unitId], references: [id])
  section     EstimateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  estimate    Estimate        @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, order])
  @@index([sectionId, order])
  @@index([roomId])
  @@map("estimate_items")
}

/// Прочий расход: цена без объёма. Входит в итог сметы, приёмке не подлежит.
model OtherExpense {
  id         String   @id @default(uuid())
  estimateId String
  unitId     String
  name       String
  order      Int
  unitPrice  BigInt
  sourceRow  Int?
  unit       Unit     @relation(fields: [unitId], references: [id])
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, order])
  @@map("other_expenses")
}

/// Протокол импорта с отчётом о расхождениях. Отчёт хранится целиком:
/// он и есть главное доказательство ценности системы, и его нельзя
/// потерять при следующем импорте.
model EstimateImport {
  id                 String   @id @default(uuid())
  estimateId         String
  fileName           String
  importedById       String?
  importedAt         DateTime @default(now())
  positions          Int
  sectionsTotal      Int
  computedWorksTotal BigInt
  declaredWorksTotal BigInt?
  /// Пересчёт минус заявленное. Положительное — недосчёт в файле.
  worksTotalDelta    BigInt?
  report             Json
  estimate           Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, importedAt])
  @@map("estimate_imports")
}

model Worker {
  id           String            @id @default(uuid())
  orgId        String
  name         String
  kind         WorkerKind        @default(BRIGADE)
  /// Ставка по умолчанию в копейках за единицу; необязательна, поскольку
  /// начисление всегда идёт по ставке позиции сметы, а не по этой.
  defaultRate  BigInt?
  batches      AcceptanceBatch[]
  accruals     WageAccrual[]
  workStages   WorkStage[]
  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@map("workers")
}

model AuthToken {
  id        String      @id @default(uuid())
  userId    String
  /// Хранится только хеш: утечка таблицы не даёт войти.
  tokenHash String      @unique
  purpose   AuthPurpose
  expiresAt DateTime
  usedAt    DateTime?
  /// Число неудачных попыток обмена. Код из шести цифр перебирается за
  /// миллион запросов, поэтому попытки ограничены, а не только время жизни.
  attempts  Int         @default(0)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Журнал аудита. Обязателен для всех денежных полей (БП-10).
/// Записи не удаляются и не изменяются.
model AuditLog {
  id           String       @id @default(uuid())
  orgId        String
  actorId      String?
  entity       String
  entityId     String
  field        String
  oldValue     String?
  newValue     String?
  at           DateTime     @default(now())
  actor        User?        @relation(fields: [actorId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entity, entityId])
  @@index([orgId, at])
  @@map("audit_log")
}

/// Помещение обмерного плана.
///
/// Прораб вносит четыре величины: площадь пола, периметр пола, периметр
/// потолка и высоту. Площадь стен и объём в базе НЕ хранятся — они
/// выводятся чистыми функциями packages/domain/src/measure.ts. Хранение
/// производной завело бы вторую правду о тех же числах, расходящуюся с
/// первой при первой же правке высоты.
///
/// Периметр пола меньше периметра потолка на ширину дверных проёмов:
/// первый — длина плинтуса, второй — замкнутая линия примыкания стен к
/// потолку. Обе величины измеряются, ни одна не выводится из площади.
model MeasureRoom {
  id               String           @id @default(uuid())
  projectId        String
  /// Набор, к которому относится помещение. Значение по умолчанию делает
  /// миграцию безоговорочной: всё, что уже обмерено, — обмер начальный.
  set              MeasureSet       @default(INITIAL)
  name             String
  order            Int
  /// Тысячные доли единицы, как количества сметы: 18,40 м² → 18400.
  floorArea        BigInt
  floorPerimeter   BigInt
  ceilingPerimeter BigInt
  height           BigInt
  createdAt        DateTime         @default(now())
  items            EstimateItem[]
  openings         MeasureOpening[]
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, set, name])
  @@index([projectId, set, order])
  @@map("measure_rooms")
}

/// Проёмы одного вида в помещении: количество, суммарная площадь,
/// суммарные откосы. Одна строка на вид — ровно то, что показывает
/// артборд. Отсутствие окон в санузле выражается отсутствием строки, а не
/// строкой нулей.
model MeasureOpening {
  id     String      @id @default(uuid())
  roomId String
  kind   OpeningKind
  count  Int
  /// Тысячные доли: площадь в м², откосы в м.п.
  area   BigInt
  reveal BigInt
  room   MeasureRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, kind])
  @@map("measure_openings")
}

/// Изображение плана объекта. Один файл на набор обмера, не на помещение:
/// рисованного контура помещения в продукте нет.
///
/// На набор, а не на объект: перепланировка меняет чертёж так же, как меняет
/// площади, и старый план рядом с новыми помещениями сообщал бы неправду
/// уверенно — хуже, чем не сообщал бы ничего.
///
/// В базе только ключ файла; сам файл лежит в хранилище за портом
/// FileStorage. Отдельная таблица, а не колонки в projects: таблица
/// объектов читается списком, сводкой и карточкой, и шесть колонок
/// метаданных файла расширяют её без нужды. Общая сущность вложения
/// появится вместе с фотоотчётами стадии C.4 — тогда эта модель станет
/// её частным случаем.
model MeasurePlan {
  id           String     @id @default(uuid())
  projectId    String
  set          MeasureSet @default(INITIAL)
  storageKey   String     @unique
  fileName     String
  contentType  String
  byteSize     Int
  uploadedById String?
  uploadedAt   DateTime   @default(now())
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id])
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, set])
  @@map("measure_plans")
}

/// Этап работ объекта — строка графика производства работ.
///
/// Первичный источник дат для экрана «Главная»: полоса плана во времени и
/// процент готовности считаются отсюда, а не из срока объекта. У объекта
/// есть `startedAt` и `deadline`, но это рамка договора, а не работа:
/// внутри неё идут штукатурка, электрика, плитка — каждая своим отрезком.
///
/// Прогресс — базисные пункты, как `supervisionShare`: 5000 = 50,00 %.
/// Целое, а не доля с плавающей точкой, по общему правилу схемы. Величина
/// заявленная: приёмки в продукте ещё нет (стадия D), и до неё прогресс
/// вносит руководитель. Экран обязан называть её заявленной.
///
/// Мастера у этапа нет: назначения и чужие задачи в объём не входят.
/// Бригада есть — но не как исполнитель задачи, а как получатель сдельного
/// начисления: приёмка раздела адресует оплату бригаде его этапа (Р2).
/// Раздел сметы связан с этапом по той же причине: без этой связи вывести
/// бригаду из принимаемого раздела нечем — этапы объекта перекрываются по
/// датам, и «этап, идущий сегодня» не определён однозначно.
model WorkStage {
  id        String           @id @default(uuid())
  projectId String
  name      String
  order     Int
  /// Даты без времени: этап меряется днями, час начала штукатурки
  /// значения не имеет и в графике не показывается.
  startsOn  DateTime
  endsOn    DateTime
  progress  Int              @default(0)
  /// Раздел сметы, работы которого ведёт этап. Необязателен: этап может
  /// стоять в графике раньше, чем смета разбита на разделы.
  sectionId String?          @unique
  /// Бригада-получатель начисления по работам этапа. Необязательна:
  /// график заводится раньше, чем известен исполнитель.
  brigadeId String?
  brigade   Worker?          @relation(fields: [brigadeId], references: [id], onDelete: Restrict)
  section   EstimateSection? @relation(fields: [sectionId], references: [id])
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, startsOn])
  @@map("work_stages")
}

/// Пакет приёмки — единица работы прораба.
///
/// Прораб принимает не позицию, а помещение: одна фотография комнаты есть
/// свидетельство по всем позициям этой комнаты. Подчинение фотографии
/// отдельной приёмке потребовало бы дублировать ссылку на файл в каждой
/// записи, что лишает свидетельство доказательной силы — нельзя отличить
/// одно свидетельство от двенадцати — и ломает сторно: отмена одной позиции
/// не должна затрагивать фото остальных.
///
/// Бригада хранится снимком, а не читается у этапа при выводе: смена
/// бригады у этапа не должна переписывать то, кому уже начислено.
model AcceptanceBatch {
  id          String            @id @default(uuid())
  projectId   String
  sectionId   String
  brigadeId   String
  createdById String?
  createdAt   DateTime          @default(now())
  comment     String?
  /// Транш, открытый на момент приёмки. Проставляется при записи и никогда
  /// не пересчитывается: открытие транша задним числом не должно переписывать
  /// уже принятое (БП-04). Пуст у пакетов, записанных до появления траншей —
  /// они показываются разрезом «вне транша», а не приписываются первому.
  trancheId   String?
  tranche     Tranche?          @relation(fields: [trancheId], references: [id])
  createdBy   User?             @relation(fields: [createdById], references: [id])
  brigade     Worker            @relation(fields: [brigadeId], references: [id])
  section     EstimateSection   @relation(fields: [sectionId], references: [id])
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos      AcceptancePhoto[]
  acceptances Acceptance[]

  @@index([projectId, createdAt])
  @@index([trancheId])
  @@map("acceptance_batches")
}

/// Приёмка одной позиции.
///
/// Отмена — сторно, а не удаление (БП-04): создаётся запись того же вида с
/// отрицательным количеством, ссылкой на сторнируемую и обязательной
/// причиной. Принятое по позиции есть сумма количеств, поэтому пара
/// «приёмка + сторно» сама себя обнуляет, а история остаётся целой.
///
/// Сторно живёт в том же пакете, что и сторнируемая приёмка: свидетельство
/// остаётся при своей фотографии, и второго фото сторно не требует.
model Acceptance {
  id          String          @id @default(uuid())
  batchId     String
  itemId      String
  /// Тысячные доли единицы измерения. У сторно отрицательное.
  qty         BigInt
  /// Заполнена у сторно и только у него.
  reason      String?
  reversesId  String?         @unique
  createdById String?
  createdAt   DateTime        @default(now())
  reverses    Acceptance?     @relation("Storno", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal    Acceptance?     @relation("Storno")
  createdBy   User?           @relation(fields: [createdById], references: [id])
  item        EstimateItem    @relation(fields: [itemId], references: [id])
  batch       AcceptanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accrual     WageAccrual?

  @@index([itemId])
  @@map("acceptances")
}

/// Начисление сдельной оплаты, порождённое приёмкой (БП-03).
///
/// Ставка хранится снимком: последующее изменение ставки в смете не
/// переписывает уже начисленное. Сумма считается один раз при записи и
/// не пересчитывается при выводе — пересчёт по действующей ставке и был бы
/// тем самым переписыванием.
model WageAccrual {
  id           String     @id @default(uuid())
  acceptanceId String     @unique
  brigadeId    String
  /// Снимок ставки позиции на момент приёмки, копейки за единицу.
  unitWage     BigInt
  /// Копейки. Знак следует за количеством: у сторно отрицательная, и пара
  /// складывается в ноль.
  amount       BigInt
  createdAt    DateTime   @default(now())
  brigade      Worker     @relation(fields: [brigadeId], references: [id])
  acceptance   Acceptance @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)

  @@index([brigadeId, createdAt])
  @@map("wage_accruals")
}

/// Фотография пакета приёмки. Обязательна: пакет без снимка свидетельством
/// не является. Хранится тем же порядком, что снимок обмерного плана —
/// файл в хранилище, ключ собирает сервер.
model AcceptancePhoto {
  id           String          @id @default(uuid())
  batchId      String
  storageKey   String          @unique
  fileName     String
  contentType  String
  byteSize     Int
  uploadedById String?
  uploadedAt   DateTime        @default(now())
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id])
  batch        AcceptanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("acceptance_photos")
}

/// Расход по объекту, подтверждённый чеком на материалы.
///
/// Отдельная модель, а не `OtherExpense`: тот означает строку
/// импортированной сметы без объёма, её пишет только парсер книги и правке
/// она не подлежит. Смешать их значило бы смешать «цену в смете» и «деньги,
/// потраченные по факту» — величины разных вопросов.
///
/// Расход не входит ни в смету, ни в транш, ни в приёмку: это учёт
/// потраченного, а не изменение цены работ.
///
/// Снимок чека обязателен и лежит теми же шестью колонками, что снимок
/// обмерного плана и фотография пакета приёмки. Это третье повторение
/// одного набора: общая сущность вложения обещана комментарием к
/// `MeasurePlan` и до сих пор не заведена — долг записан в `11_UI_AUDIT.md`.
model MaterialExpense {
  id            String           @id @default(uuid())
  projectId     String
  status        ExpenseStatus    @default(DRAFT)
  kind          ExpenseKind
  /// Копейки целым числом, как все деньги продукта (БП-08).
  amount        BigInt
  /// Возмещается ли заказчиком. Ложь — расход остаётся на студии.
  reimbursable  Boolean          @default(true)
  /// Где куплено. По чеку без продавца расход не проверить.
  seller        String
  /// Дата покупки с чека. Отличается от даты заведения записи.
  spentAt       DateTime
  /// Раздел сметы, к которому отнесён расход. Необязателен: не всякая
  /// покупка ложится на раздел, и принуждать к выбору значило бы получать
  /// неверный раздел вместо пустого.
  sectionId     String?
  note          String?
  storageKey    String           @unique
  fileName      String
  contentType   String
  byteSize      Int
  createdById   String?
  createdAt     DateTime         @default(now())
  confirmedById String?
  confirmedAt   DateTime?
  confirmedBy   User?            @relation("ExpenseConfirmer", fields: [confirmedById], references: [id])
  createdBy     User?            @relation("ExpenseAuthor", fields: [createdById], references: [id])
  section       EstimateSection? @relation(fields: [sectionId], references: [id])
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, spentAt])
  @@map("material_expenses")
}

/// Транш — сумма платежа клиента, в счёт которой идёт выработка.
///
/// Величина клиентская, а не стоимость работ: клиент платит смету с
/// надбавкой «сопровождение объекта», и расчёт остатка по стоимости работ
/// расходится с экономикой объекта на 402 726 ₽ (БП-05). Поэтому выработка
/// переводится в клиентскую сумму до вычитания, а надбавка применяется
/// одним умножением к итогу за транш — поэлементное начисление с
/// округлением до копейки накапливает расхождение (`packages/domain/src/tranche.ts`).
///
/// Выработка полем не хранится: она есть сумма принятого по пакетам этого
/// транша. Хранимое поле пришлось бы уменьшать при сторно, то есть
/// переписывать — БП-04 запрещает.
model Tranche {
  id             String            @id @default(uuid())
  projectId      String
  /// Порядковый номер у объекта. Ноль — предоплата (решение Р12): она
  /// заводится сразу оплаченной, иначе первые 30 % выпадают из картины
  /// денег на карточке объекта.
  number         Int
  /// Копейки. Сумма платежа клиента по этому траншу.
  amount         BigInt
  status         TrancheStatus     @default(OPEN)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  paidAt         DateTime?
  /// Дата подписания акта заказчиком. Отметка ставится вручную — решение
  /// заказчика от 13.09.2026. Подписание живёт между закрытием транша и
  /// оплатой, и склеивать его с ними значило бы потерять именно тот
  /// промежуток, за которым следит руководитель.
  signedAt       DateTime?
  /// Скан подписанного экземпляра акта: ключ файла, тип и день загрузки
  /// (план, пункт 4.10). Прикладывается только к подписанному акту.
  signedScanKey  String?
  signedScanType String?
  signedScanAt   DateTime?
  comment        String?
  createdById    String?
  batches        AcceptanceBatch[]
  payments       TranchePayment[]
  createdBy      User?             @relation(fields: [createdById], references: [id])
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, status])
  @@map("tranches")
}

/// Платёж заказчика в счёт транша.
///
/// Заведён ответом заказчика на вопрос 4 квиза от 19.09.2026: заказчики платят
/// частями, и это надо видеть. До него транш был единицей учёта денег целиком,
/// и частичный платёж записать было некуда.
///
/// **Состояние транша платежи не меняют.** Решение заказчика от 19.09.2026:
/// оплаченным транш называет руководитель отметкой, а не арифметика платежей.
/// Цена решения названа прямо и не спрятана: отметка и сумма платежей могут
/// разойтись. Чтобы расхождение не прошло молча — а молча оно и проходит,
/// потому что обе величины выглядят верными, — недобор считается отдельно
/// (`accounting.ts`, `shortfall`) и показывается на экране денег рядом с
/// отметкой, а не вместо неё.
///
/// Отмена — сторно, а не удаление (БП-04), тем же устройством, что у приёмки:
/// запись того же вида с отрицательной суммой, ссылкой на сторнируемую и
/// обязательной причиной. Оплачено по траншу есть сумма платежей, поэтому пара
/// «платёж + сторно» сама себя обнуляет, а история остаётся целой.
model TranchePayment {
  id           String          @id @default(uuid())
  trancheId    String
  /// Копейки. У сторно отрицательная.
  amount       BigInt
  /// Дата платежа по выписке, а не день записи в систему: деньги приходят
  /// раньше, чем их заводят, и просрочка считается по дню прихода.
  paidOn       DateTime
  /// Причина. Заполнена у сторно и только у него.
  reason       String?
  /// Сторнируемый платёж. Заполнена у сторно и только у него.
  reversalOfId String?         @unique
  comment      String?
  createdById  String?
  createdAt    DateTime        @default(now())
  reversalOf   TranchePayment? @relation("PaymentStorno", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal     TranchePayment? @relation("PaymentStorno")
  createdBy    User?           @relation(fields: [createdById], references: [id])
  tranche      Tranche         @relation(fields: [trancheId], references: [id], onDelete: Cascade)

  @@index([trancheId, paidOn])
  @@map("tranche_payments")
}

/// Справочник типов ремонта с тарифом за квадратный метр.
///
/// Тарифы правятся на экране настроек, а не зашиты в код: цены меняются
/// чаще, чем выходят редакции продукта (решение заказчика от 11.09.2026).
model RepairType {
  id           String       @id @default(uuid())
  orgId        String
  name         String
  /// Копейки за квадратный метр.
  ratePerSqm   BigInt
  /// Отклонение вилки в сотых долях процента: 1500 — это ±15 %.
  spread       Int          @default(1500)
  order        Int          @default(0)
  leads        Lead[]
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@map("repair_types")
}

/// Заявка — обращение до того, как оно стало объектом.
model Lead {
  id             String       @id @default(uuid())
  orgId          String
  /// Сквозной номер в рамках организации, как в обиходе: № 1044.
  number         Int
  name           String
  phone          String
  /// Адрес объекта со слов обратившегося. Нужен при превращении в объект.
  address        String?
  note           String?
  stage          LeadStage    @default(FIRST_CONTACT)
  outcome        LeadOutcome  @default(OPEN)
  /// Причина отказа. Заполняется вместе с outcome = LOST и только с ним.
  lostReason     String?
  /// Дата отказа. От неё отсчитывается срок хранения персональных данных
  /// (`LEAD_RETENTION_DAYS`, ч. 7 ст. 21 152-ФЗ; П-40, 02.10.2026).
  lostAt         DateTime?
  /// Дата обезличивания отказной заявки; пусто — не обезличена.
  ///
  /// Имя, телефон, адрес и заметка заменяются, причина отказа, стадия,
  /// ориентир и задачи остаются: они — сведения о воронке, а не о человеке
  /// (решение заказчика от 01.10.2026, П-40). Журнал заявки не трогается.
  anonymizedAt   DateTime?
  repairTypeId   String?
  /// Общая площадь по документам, тысячные квадратного метра.
  area           BigInt?
  /// Снимок тарифа и отклонения на момент расчёта ориентира.
  ///
  /// По тому же правилу, по которому приёмка хранит снимок ставки (БП-03):
  /// правка справочника не вправе задним числом изменить цену, названную
  /// заказчику по телефону.
  rateSnapshot   BigInt?
  spreadSnapshot Int?
  /// Заведённые превращением. Заявка остаётся и после него.
  clientId       String?
  projectId      String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tasks          LeadTask[]
  project        Project?     @relation(fields: [projectId], references: [id])
  client         Client?      @relation(fields: [clientId], references: [id])
  repairType     RepairType?  @relation(fields: [repairTypeId], references: [id])
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, number])
  @@index([orgId, stage])
  @@index([outcome, anonymizedAt, lostAt])
  @@map("leads")
}

/// Задача по заявке. Срок и отметка выполнения; просрочка вычисляется по
/// дате, а не хранится признаком — иначе она врёт до первого пересчёта.
model LeadTask {
  id           String       @id @default(uuid())
  orgId        String
  leadId       String
  title        String
  dueOn        DateTime
  doneAt       DateTime?
  createdAt    DateTime     @default(now())
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_tasks")
}

model Feedback {
  id             String           @id @default(uuid())
  orgId          String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  kind           FeedbackKind
  authorRole     Role
  /// `#[объект]/estimate`
  routeTemplate  String
  /// подпись раздела
  section        String
  /// `R-99`, только видимый автору объект организации
  objectCode     String?
  tab            String
  text           String
  device         String
  viewportWidth  Int?
  /// `feedback/<uuid>.<ext>` в FileStorage
  screenshotKey  String?
  screenshotType String?
  screenshotSize Int?
  severityAuto   FeedbackSeverity
  severity       FeedbackSeverity
  status         FeedbackStatus   @default(NEW)
  note           String?
  resolvedAt     DateTime?
  organization   Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt])
  @@index([orgId, createdAt])
  @@map("feedback")
}

/// Файлы объекта (вкладка «Файлы», Э7, кандидат).
///
/// Загружает руководитель и прораб: договоры, доп. соглашения, сканы,
/// фотографии вне приёмки. Ключ файла собирает сервер, от клиента не
/// приходит. Тип определяется по первым байтам (SVG не принимается).
///
/// Хранится тем же порядком, что снимки чеков и фотоотчёта: ключ, имя,
/// тип, размер.
model ProjectFile {
  id           String   @id @default(uuid())
  projectId    String
  key          String   @unique
  fileName     String
  contentType  String
  byteSize     Int
  uploadedById String?
  uploadedAt   DateTime @default(now())
  description  String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, uploadedAt])
  @@map("project_files")
}

/// Роли системы. Клиент личного кабинета в первой версии не имеет
/// и в таблице пользователей не заводится.
/// Четыре рабочие роли продукта.
///
/// `SUPPLY` снята решением заказчика от 13.09.2026: она была объявлена в схеме
/// и защищена проекцией, но входа не имела ни на одном экране (дефект А-7).
/// Объявленная и не выданная роль обещает доступ, которого нет. Урок этот
/// действует и для `ACCOUNTANT`: роль заводится вместе со входом, экранами и
/// данными, а не объявлением в перечне.
///
/// `ACCOUNTANT` — бухгалтер. Заведена ответом заказчика на вопрос 7 квиза от
/// 19.09.2026 и отменяет прежний довод «в компании нет бухгалтера, деньги в
/// системе не двигаются» (`01_PROJECT.md`). Решением от 19.09.2026 ей открыто
/// всё, что открыто руководителю, кроме настроек организации и выдачи входа, —
/// включая внутренние величины (`projection.ts`, `OWNER_LEVEL`).
///
/// `CLIENT` — заказчик объекта. Видит ход работ по своему объекту и бумаги по
/// нему; внутренних величин не получает наравне с прорабом (`projection.ts`).
enum Role {
  OWNER
  FOREMAN
  ACCOUNTANT
  CLIENT
}

/// Текущий рабочий статус объекта.
enum ProjectStatus {
  NEW
  IN_PROGRESS
  PAUSED
  WAITING_CLIENT
  DONE
  ARCHIVED
}

/// Состояние транша.
///
/// Закрытие и оплата разделены намеренно: транш закрывается, когда работы
/// по нему выработаны, а оплачивается, когда деньги пришли, — между этими
/// событиями проходят дни, и склеивание их в один статус скрыло бы от
/// руководителя именно тот промежуток, за которым он следит.
enum TrancheStatus {
  /// Накапливает выработку. Открытый транш у объекта не более одного.
  OPEN
  /// Закрыт руководителем. Формирование акта — пункт плана 4.7.
  CLOSED
  /// Оплачен клиентом.
  PAID
}

/// Расчётная единица сдельной оплаты. По решению допроса расчёт ведётся
/// с бригадой через бригадира, состав бригады не хранится; тип PERSON
/// оставлен для объектов, где рассчитываются с конкретным мастером.
/// Вид проёма обмерного плана. Величины хранятся измеренными итогами по
/// виду, а не выводятся из размеров: у двери спальни площадь 1,68 м² и
/// откосы 5,05 м.п. не даёт ни одна пара размеров — откосы у двери
/// трёхсторонние и меряются по месту.
enum OpeningKind {
  WINDOW
  DOOR
}

/// Набор обмера. Их ровно два, и это не заготовка под список: заказчик
/// назвал задачу «второй набор — после перепланировки, рядом с начальным».
/// Перечисление из двух значений отвечает на этот вопрос и ни на какой
/// другой; список наборов с именами и порядком отвечал бы на вопрос,
/// которого никто не задавал, и стоил бы отдельного экрана управления ими.
///
/// INITIAL — обмер до работ, по нему считалась смета.
/// REPLANNED — обмер после перепланировки: снесённые перегородки меняют
/// площади, и прежние величины перестают быть правдой, не переставая быть
/// историей. Поэтому второй набор именно рядом с первым, а не поверх него.
enum MeasureSet {
  INITIAL
  REPLANNED
}

/// Состояние расхода по чеку.
///
/// Три значения, а не два. Отклонённый не удаляется: история не
/// переписывается (БП-04), и «почему этот чек не возместили» спрашивают
/// через месяц — так же, как «кто перевёл объект в паузу». Удаление
/// допускается только для черновика: он ещё ничего не значит.
enum ExpenseStatus {
  DRAFT
  CONFIRMED
  REJECTED
}

/// Вид расхода. Список закрытый — решение заказчика от 13.09.2026.
enum ExpenseKind {
  MATERIALS
  DELIVERY
  TOOLS
  OTHER
}

enum WorkerKind {
  BRIGADE
  PERSON
}

/// Стадия воронки заявок. Четыре, по фактическому процессу компании
/// (01_PROJECT.md, раздел 4, шаги 1–3) и утверждённому макету.
enum LeadStage {
  /// Обращение поступило, разговора ещё не было.
  FIRST_CONTACT
  /// Выезд на объект, знакомство и обмер.
  MEETING
  /// Смета составлена, заказчик думает.
  DECIDING
  /// Договор и предоплата 30 %.
  CONTRACT
}

/// Исход заявки. Выигранная и отказная уходят из воронки, но не удаляются:
/// история не переписывается (БП-04).
enum LeadOutcome {
  OPEN
  WON
  LOST
}

/// Назначение одноразовой ссылки входа.
enum AuthPurpose {
  /// Магическая ссылка руководителя, живёт минуты.
  MAGIC_LINK
  /// Персональная ссылка прораба: он не вводит ничего вообще.
  FOREMAN_LINK
  /// Код подтверждения из шести цифр, живёт пять минут.
  SMS_CODE
}

/// Вид документа организации. Закрытый список: конструктор выпускает бумаги
/// определённого назначения, а не «любой текст». Акт в списке отсутствует
/// намеренно — он собирается из принятых позиций и шаблоном не правится
/// (решение заказчика от 13.09.2026).
enum TemplateKind {
  CONTRACT
  ANNEX
  OTHER
}

/// Замечание о платформе с кнопки в кабинете (перенос Р-403 ProDisser).
/// Автор — ролью, без имени: замечание описывает экран, а не человека.
enum FeedbackKind {
  DEFECT
  IDEA
  COMMENT
  WORKS
}

enum FeedbackSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FeedbackStatus {
  NEW
  IN_WORK
  DONE
  DECLINED
}
